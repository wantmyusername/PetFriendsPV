---
import { t } from "../i18n/translations";

interface Props {
    lang?: string;
}

const lang = Astro.props.lang || "en";
const dict = t[lang].popup;
const whatsappLink = `https://wa.me/523223846328?text=${encodeURIComponent(t[lang].whatsapp.emergency)}`;
---

<div id="pf-emergency-popup" class="hidden fixed inset-0 z-[100] flex items-center justify-center overflow-y-auto p-4 sm:p-6"
    data-popup role="dialog" aria-modal="true" aria-labelledby="pf-emergency-popup-title"
    aria-describedby="pf-emergency-popup-desc">
    <!-- Backdrop -->
    <div class="pf-popup-backdrop absolute inset-0 bg-[#0e144a]/75" data-popup-backdrop></div>

    <!-- Panel -->
    <div
        class="pf-popup-panel relative my-auto w-full max-w-xl sm:max-w-2xl max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-[1.75rem] sm:rounded-[2rem] bg-white shadow-[0_30px_80px_-15px_rgba(10,14,53,0.6)] border-2 border-[#007b8a]/20">
        <!-- Top accent -->
        <div class="h-2 w-full bg-gradient-to-r from-[#0091a1] via-[#41c4d1] to-[#0091a1]"></div>

        <button type="button" data-popup-close aria-label={dict.close}
            class="absolute right-3 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-zinc-100 text-zinc-700 transition-colors hover:bg-zinc-200 hover:text-[#0e144a] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#007b8a] focus-visible:ring-offset-2 sm:right-4 sm:top-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                stroke-width="2.4" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
        </button>

        <div class="px-6 pb-8 pt-7 sm:px-10 sm:pb-10 sm:pt-9">
            <div class="mb-6 flex items-start gap-4 pr-12">
                <div
                    class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-[#007b8a] text-white shadow-md shadow-[#0091a1]/25">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                        stroke-width="1.8" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M12 21s-7.5-4.35-9.75-9.15C.9 8.72 3 5.25 6.6 5.25c2.02 0 3.3 1.05 4.05 2.1.38.53.66.9 1.35.9s.97-.37 1.35-.9c.75-1.05 2.03-2.1 4.05-2.1 3.6 0 5.7 3.47 4.35 6.6C19.5 16.65 12 21 12 21Z" />
                    </svg>
                </div>
                <div class="pt-1">
                    <span class="block text-xs font-bold uppercase tracking-[0.2em] text-[#007b8a]">
                        {dict.eyebrow}
                    </span>
                    <span
                        class="mt-2 inline-flex items-center gap-2 rounded-full bg-[#007b8a]/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-[#007b8a]">
                        <span class="h-2 w-2 animate-pulse rounded-full bg-[#007b8a]"></span>
                        24/7
                    </span>
                </div>
            </div>

            <h2 id="pf-emergency-popup-title"
                class="font-fredoka text-[28px] font-bold leading-[1.15] text-[#0e144a] sm:text-4xl">
                {dict.title}
            </h2>
            <p id="pf-emergency-popup-desc" class="mt-4 font-readex text-base font-normal leading-relaxed text-[#334155] sm:text-lg"
                set:html={dict.message}></p>

            <div class="mt-7 space-y-3">
                <a href={whatsappLink} target="_blank" rel="noopener noreferrer"
                    class="inline-flex min-h-[54px] w-full items-center justify-center gap-2.5 rounded-full bg-[#007b8a] px-6 py-4 text-base font-bold text-white shadow-lg shadow-[#007b8a]/30 transition-all hover:bg-[#006b78] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#007b8a] focus-visible:ring-offset-2 active:scale-[0.99] sm:text-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 448 512">
                        <path
                            d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
                    </svg>
                    {dict.whatsappCta}
                </a>
                <button type="button" data-popup-close data-popup-accept
                    class="inline-flex min-h-[52px] w-full items-center justify-center rounded-full border-2 border-zinc-200 bg-white px-6 py-4 text-base font-bold text-[#0e144a] transition-colors hover:border-zinc-300 hover:bg-zinc-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#007b8a] focus-visible:ring-offset-2 sm:text-lg">
                    {dict.close}
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .pf-popup-backdrop {
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .pf-popup-panel {
        opacity: 0;
        transform: translateY(14px) scale(0.97);
        transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #pf-emergency-popup.is-visible .pf-popup-backdrop {
        opacity: 1;
    }

    #pf-emergency-popup.is-visible .pf-popup-panel {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
        .pf-popup-backdrop,
        .pf-popup-panel {
            transition: none;
        }
    }
</style>

<script>
    (() => {
        const popup = document.getElementById("pf-emergency-popup");
        if (!popup) return;

        const STORAGE_KEY = "pf_emergency_popup_dismissed_at";
        const TTL_MS = 7 * 24 * 60 * 60 * 1000;

        let dismissedAt = 0;
        try {
            dismissedAt = Number(localStorage.getItem(STORAGE_KEY)) || 0;
        } catch {
            dismissedAt = 0;
        }

        if (dismissedAt && Date.now() - dismissedAt < TTL_MS) return;

        let lastFocused: HTMLElement | null = null;
        let closeTimer: number | undefined;

        const open = () => {
            lastFocused = document.activeElement as HTMLElement | null;
            popup.classList.remove("hidden");
            document.body.style.overflow = "hidden";
            requestAnimationFrame(() => popup.classList.add("is-visible"));
            popup.querySelector<HTMLElement>("[data-popup-accept]")?.focus();
        };

        const close = () => {
            try {
                localStorage.setItem(STORAGE_KEY, String(Date.now()));
            } catch {
                /* storage unavailable */
            }
            popup.classList.remove("is-visible");
            document.body.style.overflow = "";
            closeTimer = window.setTimeout(() => popup.classList.add("hidden"), 320);
            lastFocused?.focus();
        };

        popup.querySelectorAll("[data-popup-close]").forEach((el) => {
            el.addEventListener("click", close);
        });

        popup.querySelector("[data-popup-backdrop]")?.addEventListener("click", close);

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && popup.classList.contains("is-visible")) {
                close();
            }
        });

        window.addEventListener("pagehide", () => {
            if (closeTimer) window.clearTimeout(closeTimer);
        });

        window.setTimeout(open, 900);
    })();
</script>
