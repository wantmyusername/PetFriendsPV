---
import { t } from "../i18n/translations";
const { lang = "en" } = Astro.props;
const dict = t[lang];
const p = (path) => {
  const withSlash = path === "/" ? "/" : `${path.replace(/\/+$/, "")}/`;
  return lang === "en" ? withSlash : `/es${withSlash}`;
};
---

<footer class="font-readex bg-[#ffffff] text-[#0e144a] relative overflow-hidden">

    <!-- Efecto decorativo de luz turquesa de fondo (Lujo Lujoso) -->
    <div
        class="absolute bottom-0 right-0 w-[450px] h-[450px] rounded-full bg-[#007b8a]/5 blur-[120px] pointer-events-none z-0">
    </div>

    <!-- 1. CLINICAL PILLARS -->
    <div
        class="relative z-10 border-t border-b border-[#cce9ed] bg-[#e6f4f6] grid grid-cols-1 divide-y divide-zinc-200/50 sm:grid-cols-2 lg:grid-cols-4 lg:divide-y-0 lg:divide-x lg:divide-zinc-200/50">

        <!-- Pillar 1: Aesthetic Medicine -->
        <div class="group flex gap-6 p-10 transition-colors duration-300 hover:bg-[#006b78]/[0.02]">
            <div class="text-[#007b8a] flex-shrink-0 transition-transform duration-300 group-hover:-translate-y-1">
                <img src="/dog-grooming.svg" alt="" class="w-8 h-8"
                    style="filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(635%) hue-rotate(148deg);" />
            </div>
            <div class="space-y-1">
                <h3 class="font-fredoka text-base font-bold tracking-tight text-[#0e144a]">{dict.footer.pillars.aesthetic.title}</h3>
                <p class="text-sm text-zinc-600 leading-relaxed">
                    {dict.footer.pillars.aesthetic.desc}
                </p>
            </div>
        </div>

        <!-- Pillar 2: Advanced Therapeutics -->
        <div class="group flex gap-6 p-10 transition-colors duration-300 hover:bg-[#006b78]/[0.02]">
            <div class="text-[#007b8a] flex-shrink-0 transition-transform duration-300 group-hover:-translate-y-1">
                <img src="/veterinary-care.svg" alt="" class="w-8 h-8"
                    style="filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(635%) hue-rotate(148deg);" />
            </div>
            <div class="space-y-1">
                <h3 class="font-fredoka text-base font-bold tracking-tight text-[#0e144a]">{dict.footer.pillars.therapeutics.title}</h3>
                <p class="text-sm text-zinc-600 leading-relaxed">
                    {dict.footer.pillars.therapeutics.desc}
                </p>
            </div>
        </div>

        <!-- Pillar 3: Prescription Nutrition -->
        <div class="group flex gap-6 p-10 transition-colors duration-300 hover:bg-[#006b78]/[0.02]">
            <div class="text-[#007b8a] flex-shrink-0 transition-transform duration-300 group-hover:-translate-y-1">
                <img src="/nutritional.svg" alt="" class="w-8 h-8"
                    style="filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(635%) hue-rotate(148deg);" />
            </div>
            <div class="space-y-1">
                <h3 class="font-fredoka text-base font-bold tracking-tight text-[#0e144a]">{dict.footer.pillars.nutrition.title}</h3>
                <p class="text-sm text-zinc-600 leading-relaxed">
                    {dict.footer.pillars.nutrition.desc}
                </p>
            </div>
        </div>

        <!-- Pillar 4: Behavioral Therapy -->
        <div class="group flex gap-6 p-10 transition-colors duration-300 hover:bg-[#006b78]/[0.02]">
            <div class="text-[#007b8a] flex-shrink-0 transition-transform duration-300 group-hover:-translate-y-1">
                <img src="/dog-training.svg" alt="" class="w-8 h-8"
                    style="filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(635%) hue-rotate(148deg);" />
            </div>
            <div class="space-y-1">
                <h3 class="font-fredoka text-base font-bold tracking-tight text-[#0e144a]">{dict.footer.pillars.behavior.title}</h3>
                <p class="text-sm text-zinc-600 leading-relaxed">
                    {dict.footer.pillars.behavior.desc}
                </p>
            </div>
        </div>
    </div>

    <!-- 2. MAIN FOOTER (Estructura de alta gama y espacio abierto) -->
    <div class="relative z-10 max-w-7xl mx-auto px-8 py-24 grid grid-cols-1 gap-16 md:grid-cols-2 lg:grid-cols-12">

        <!-- Brand Identity (4/12 col) -->
        <div class="space-y-8 lg:col-span-4">
            <div class="flex items-center gap-4.5">
                <img src="/logo-footer.png" alt="Pet Friends Puerto Vallarta" class="h-32 w-auto" />
            </div>

            <p class="text-zinc-600 text-sm leading-relaxed max-w-sm">
                {dict.footer.dedicated}
            </p>

            <!-- Social Links minimalistas en gris táctil -->
            <div class="flex gap-4">
                <a href="https://www.facebook.com/petfriendspv" aria-label="Facebook Link"
                    class="w-8 h-8 rounded-lg bg-zinc-100 flex items-center justify-center text-zinc-600 transition-all hover:bg-[#006b78]/10 hover:text-[#007b8a]">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M9 8H7v3h2v9h3v-9h4.5l.5-3H12V6c0-.88.72-1 1-1h3V2h-3c-3.31 0-6 2.69-6 6z" />
                    </svg>
                </a>
                <a href="https://www.instagram.com/petfriendspv/" aria-label="Instagram Link"
                    class="w-8 h-8 rounded-lg bg-zinc-100 flex items-center justify-center text-zinc-600 transition-all hover:bg-[#006b78]/10 hover:text-[#007b8a]">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path
                            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" />
                    </svg>
                </a>
            </div>
        </div>

        <!-- Specialties (texto plano, no clickeable) -->
        <div class="lg:col-span-2 space-y-6">
            <h3 class="font-fredoka text-xs font-bold uppercase tracking-[0.2em] text-[#0e144a]">
                {dict.footer.specialties}
            </h3>
            <ul class="space-y-4 text-xs font-medium text-zinc-600">
                <li class="flex items-center gap-3">
                    <span class="text-[#007b8a]">&#8212;</span>
                    {dict.footer.surgeryIcu}
                </li>
                <li class="flex items-center gap-3">
                    <span class="text-[#007b8a]">&#8212;</span>
                    {dict.footer.internalMedicine}
                </li>
                <li class="flex items-center gap-3">
                    <span class="text-[#007b8a]">&#8212;</span>
                    {dict.footer.digitalRadiology}
                </li>
                <li class="flex items-center gap-3">
                    <span class="text-[#007b8a]">&#8212;</span>
                    {dict.footer.healthCertificates}
                </li>
                <li class="flex items-center gap-3">
                    <span class="text-[#007b8a]">&#8212;</span>
                    {dict.footer.aestheticTherapy}
                </li>
            </ul>
        </div>

        <!-- Site Sections (links del navbar) -->
        <div class="lg:col-span-2 space-y-6">
            <h3 class="font-fredoka text-xs font-bold uppercase tracking-[0.2em] text-[#0e144a]">
                {dict.footer.sections}
            </h3>
            <ul class="space-y-4 text-xs font-medium text-zinc-600">
                <li>
                    <a href={p('/')}
                        class="group flex items-center gap-0 hover:text-[#007b8a] transition-all duration-300">
                        <span
                            class="w-0 opacity-0 text-[#007b8a] transition-all duration-300 group-hover:w-3.5 group-hover:opacity-100">&#8212;</span>
                        {dict.nav.home}
                    </a>
                </li>
                <li>
                    <a href={p('/about-us')}
                        class="group flex items-center gap-0 hover:text-[#007b8a] transition-all duration-300">
                        <span
                            class="w-0 opacity-0 text-[#007b8a] transition-all duration-300 group-hover:w-3.5 group-hover:opacity-100">&#8212;</span>
                        {dict.nav.about}
                    </a>
                </li>
                <li>
                    <a href={p('/services')}
                        class="group flex items-center gap-0 hover:text-[#007b8a] transition-all duration-300">
                        <span
                            class="w-0 opacity-0 text-[#007b8a] transition-all duration-300 group-hover:w-3.5 group-hover:opacity-100">&#8212;</span>
                        {dict.nav.services}
                    </a>
                </li>
                <li>
                    <a href={p('/gallery')}
                        class="group flex items-center gap-0 hover:text-[#007b8a] transition-all duration-300">
                        <span
                            class="w-0 opacity-0 text-[#007b8a] transition-all duration-300 group-hover:w-3.5 group-hover:opacity-100">&#8212;</span>
                        {dict.nav.gallery}
                    </a>
                </li>
                <li>
                    <a href={p('/contact-us')}
                        class="group flex items-center gap-0 hover:text-[#007b8a] transition-all duration-300">
                        <span
                            class="w-0 opacity-0 text-[#007b8a] transition-all duration-300 group-hover:w-3.5 group-hover:opacity-100">&#8212;</span>
                        {dict.nav.contact}
                    </a>
                </li>
            </ul>
        </div>

        <!-- 3. PANEL DE ESTADO CLÍNICO ACTIVO (Editorial, limpio y premium) -->
        <div
            class="lg:col-span-4 space-y-8 lg:pl-6 border-t lg:border-t-0 lg:border-l border-zinc-200/60 pt-12 lg:pt-0">

            <!-- Horarios detallados (Typographic style) -->
            <div class="space-y-1">
                <span class="text-xs font-bold uppercase tracking-[0.15em] text-zinc-600 block">{dict.footer.consultationHours}</span>
                <p class="text-sm font-semibold text-[#0e144a]">Mon - Fri: 9:00 AM &mdash; 10:00 PM CST</p>
                <p class="text-sm text-zinc-600">Sat: 9:00 AM &mdash; 6:00 PM CST</p>
                <p class="text-sm text-zinc-600">Sun: 10:00 AM &mdash; 6:00 PM CST</p>
            </div>

            <!-- Hotline de Emergencias Editorial -->
            <div class="space-y-2 pt-2">
                <span class="text-xs font-bold uppercase tracking-[0.15em] text-[#007b8a] block">{dict.footer.traumaEmergency}</span>
                <a href={`https://wa.me/523223846328?text=${encodeURIComponent(dict.whatsapp.emergency)}`}
                    target="_blank" rel="noopener noreferrer"
                    class="font-fredoka text-2xl font-bold tracking-tight text-[#0e144a] hover:text-[#007b8a] transition-colors relative group inline-flex items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 448 512">
                        <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
                    </svg>
                    +52 322 384 6328
                    <span
                        class="absolute bottom-0 left-0 w-28 h-0.5 bg-[#007b8a] transform scale-x-100 group-hover:scale-x-110 transition-transform duration-300"></span>
                </a>
                <p class="text-xs text-zinc-600 leading-normal">
                    {dict.footer.directValidation}
                </p>
                <p class="text-xs text-zinc-600 leading-normal">
                    <a href="tel:+523222232760" class="font-semibold hover:text-[#007b8a] transition-colors">+52 322 223 2760</a>
                    <span class="mx-1.5 opacity-40">·</span>{dict.footer.officePhone}
                </p>
            </div>
        </div>

    </div>

    <!-- 4. BOTTOM PANEL (Copyright & Créditos de pago discretos) -->
    <div class="relative z-10 border-t border-[#cce9ed] bg-[#e6f4f6]">
        <div
            class="mx-auto max-w-7xl flex flex-col items-center justify-between gap-6 px-8 py-8 text-xs text-zinc-600 md:flex-row">
            <p class="tracking-wide">
                &copy; {new Date().getFullYear()} Pet Friends Puerto Vallarta
                <span class="mx-2 opacity-30">|</span>
                <a href={p('/terms')} class="hover:text-[#007b8a] transition-colors">{dict.footer.terms}</a>
            </p>

            <!-- Payment Methods -->
            <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 select-none md:mr-6 md:justify-end md:text-right lg:mr-10">
                <span class="text-sm font-bold uppercase tracking-[0.15em] text-zinc-600">
                    {dict.footer.weAccept}
                </span>
                <img src="/visa_logo.svg" alt="Visa" class="h-6 w-auto opacity-90 transition-opacity duration-200 hover:opacity-100" />
                <img src="/master-card.svg" alt="Mastercard" class="h-6 w-auto opacity-90 transition-opacity duration-200 hover:opacity-100" />
                <img src="/amex_logo.svg" alt="American Express" class="h-6 w-auto opacity-90 transition-opacity duration-200 hover:opacity-100" />
                <img src="/spei_logo.svg" alt="SPEI" class="h-6 w-auto opacity-90 transition-opacity duration-200 hover:opacity-100" />
                <p class="w-full text-center text-sm leading-relaxed text-zinc-600 md:text-right">
                    {dict.footer.paymentMethods}
                </p>
            </div>
        </div>
    </div>
</footer>