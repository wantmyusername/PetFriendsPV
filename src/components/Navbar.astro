---
import { t } from "../i18n/translations";
const { lang = "en", currentPath = "/" } = Astro.props;
const dict = t[lang];
const p = (path) => {
  const withSlash = path === "/" ? "/" : `${path.replace(/\/+$/, "")}/`;
  return lang === "en" ? withSlash : `/es${withSlash}`;
};
const toggleLang = lang === "en" ? "es" : "en";
const basePath = currentPath.replace(/^\/es/, "") || "/";
const toggledBase = basePath.endsWith("/") ? basePath : `${basePath}/`;
const togglePath = lang === "en" ? `/es${toggledBase}` : toggledBase;
---

<header id="main-header"
    class="fixed top-5 left-1/2 z-50 w-[95%] max-w-7xl -translate-x-1/2 font-readex transition-all duration-500 ease-in-out">

    <nav id="nav-container"
        class="flex items-center justify-between rounded-full border border-white/30 bg-white/75 px-3 py-2.5 shadow-[0_8px_30px_-10px_rgba(0,145,161,0.12)] backdrop-blur-md transition-all duration-500">

        <!-- Logo Area -->
        <a href={p('/')} class="group flex shrink-0 items-center pl-2">

            <img src="/logo.png" alt="Pet Friends Puerto Vallarta"
                class="h-12 w-auto transition-transform duration-300 group-hover:scale-105" />

        </a>

        <!-- Desktop Navigation -->
        <ul class="hidden items-center gap-1 font-readex md:flex" id="desktop-menu">

            <li>
                <a href={p('/')} data-path="/"
                    class="nav-link rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-600 transition-all duration-200 hover:bg-[#006b78]/5 hover:text-[#007b8a]">
                    {dict.nav.home}
                </a>
            </li>

            <li>
                <a href={p('/about-us')} data-path="/about-us"
                    class="nav-link rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-600 transition-all duration-200 hover:bg-[#006b78]/5 hover:text-[#007b8a]">
                    {dict.nav.about}
                </a>
            </li>

            <li>
                <a href={p('/services')} data-path="/services"
                    class="nav-link rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-600 transition-all duration-200 hover:bg-[#006b78]/5 hover:text-[#007b8a]">
                    {dict.nav.services}
                </a>
            </li>

            <li>
                <a href={p('/gallery')} data-path="/gallery"
                    class="nav-link rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-600 transition-all duration-200 hover:bg-[#006b78]/5 hover:text-[#007b8a]">
                    {dict.nav.gallery}
                </a>
            </li>

            <li>
                <a href={p('/contact-us')} data-path="/contact-us"
                    class="nav-link rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-600 transition-all duration-200 hover:bg-[#006b78]/5 hover:text-[#007b8a]">
                    {dict.nav.contact}
                </a>
            </li>

        </ul>

        <!-- Desktop Actions -->
        <div class="hidden items-center gap-2 pr-1 md:flex">

            <!-- Language -->
            <a href={togglePath}
                class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold uppercase tracking-[0.18em] text-zinc-600 transition-all duration-300 hover:text-[#007b8a]">

                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70">
                    <path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>
                </svg>

                <span>{dict.langLabel}</span>

            </a>

            <!-- CTA -->
            <a href={p('/contact-us')}
                class="group relative inline-flex min-h-[44px] items-center justify-center gap-2.5 overflow-hidden rounded-full bg-[#007b8a] px-5 py-3 text-xs font-bold uppercase tracking-wider text-white shadow-sm transition-all duration-300 hover:bg-[#006b78] hover:shadow-md active:scale-95">

                <img src="/huella.svg" alt="" class="relative z-10 h-4 w-4 transition-transform duration-300 group-hover:rotate-12" style="filter: brightness(0) invert(1);" />

                <span class="relative z-10">
                    {dict.nav.bookAppointment}
                </span>

            </a>

        </div>

        <!-- Mobile Actions -->
        <div class="flex items-center gap-2 pr-1 md:hidden">

            <!-- Language -->
            <a href={togglePath}
                class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200/80 bg-white px-3 py-2 text-xs font-bold uppercase tracking-[0.14em] text-zinc-700 shadow-sm transition-all duration-300 hover:border-[#007b8a]/30 hover:text-[#007b8a]">

                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70">
                    <path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>
                </svg>

                <span>{dict.langLabel}</span>

            </a>

            <!-- Menu Button -->
            <button id="menu-btn" aria-label="Menu"
                class="flex h-10 w-10 items-center justify-center rounded-full border border-zinc-200/80 bg-white text-[#007b8a] shadow-sm transition-colors duration-300 hover:bg-zinc-50 focus:outline-none">

                <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                    stroke-width="2.5" stroke="currentColor" class="h-5 w-5 transition-transform duration-300">

                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6h16.5" />

                </svg>

            </button>

        </div>

    </nav>

    <!-- Mobile Drawer -->
    <div id="mobile-menu"
        class="pointer-events-none absolute left-1/2 z-50 mt-3 w-[98%] origin-top -translate-x-1/2 scale-95 rounded-[2rem] border border-zinc-200/60 bg-[#ffffff]/98 p-8 opacity-0 shadow-[0_25px_60px_-15px_rgba(0,145,161,0.18)] backdrop-blur-xl transition-all duration-300 ease-out md:hidden">

        <div class="space-y-8">

            <!-- Navigation -->
            <div class="space-y-4">

                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-zinc-600">
                    {dict.nav.navigation}
                </span>

                <ul class="flex flex-col gap-1.5">

                    <li>
                        <a href={p('/')} data-path="/"
                            class="mobile-nav-link flex items-center rounded-xl px-4 py-3 font-readex text-xs font-bold uppercase tracking-wider text-zinc-700 transition-all hover:bg-[#006b78]/5 hover:text-[#007b8a]">

                            <span class="nav-number mr-3 font-fredoka text-xs font-semibold text-[#007b8a]">
                                01 /
                            </span>

                            {dict.nav.home}

                        </a>
                    </li>

                    <li>
                        <a href={p('/about-us')} data-path="/about-us"
                            class="mobile-nav-link flex items-center rounded-xl px-4 py-3 font-readex text-xs font-bold uppercase tracking-wider text-zinc-700 transition-all hover:bg-[#006b78]/5 hover:text-[#007b8a]">

                            <span class="nav-number mr-3 font-fredoka text-xs font-semibold text-[#007b8a]">
                                02 /
                            </span>

                            {dict.nav.about}

                        </a>
                    </li>

                    <li>
                        <a href={p('/services')} data-path="/services"
                            class="mobile-nav-link flex items-center rounded-xl px-4 py-3 font-readex text-xs font-bold uppercase tracking-wider text-zinc-700 transition-all hover:bg-[#006b78]/5 hover:text-[#007b8a]">

                            <span class="nav-number mr-3 font-fredoka text-xs font-semibold text-[#007b8a]">
                                03 /
                            </span>

                            {dict.nav.services}

                        </a>
                    </li>

                    <li>
                        <a href={p('/gallery')} data-path="/gallery"
                            class="mobile-nav-link flex items-center rounded-xl px-4 py-3 font-readex text-xs font-bold uppercase tracking-wider text-zinc-700 transition-all hover:bg-[#006b78]/5 hover:text-[#007b8a]">

                            <span class="nav-number mr-3 font-fredoka text-xs font-semibold text-[#007b8a]">
                                04 /
                            </span>

                            {dict.nav.gallery}

                        </a>
                    </li>

                    <li>
                        <a href={p('/contact-us')} data-path="/contact-us"
                            class="mobile-nav-link flex items-center rounded-xl px-4 py-3 font-readex text-xs font-bold uppercase tracking-wider text-zinc-700 transition-all hover:bg-[#006b78]/5 hover:text-[#007b8a]">

                            <span class="nav-number mr-3 font-fredoka text-xs font-semibold text-[#007b8a]">
                                05 /
                            </span>

                            {dict.nav.contact}

                        </a>
                    </li>

                </ul>

            </div>

            <!-- CTA -->
            <div class="space-y-4 border-t border-zinc-200/60 pt-6">

                <a href={`https://wa.me/523223846328?text=${encodeURIComponent(dict.whatsapp.emergency)}`}
                    target="_blank" rel="noopener noreferrer"
                    class="flex flex-col items-center gap-1 rounded-xl border border-rose-100 bg-rose-50/80 p-4 text-rose-700 transition-colors hover:bg-rose-100">

                    <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 448 512">
                            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
                        </svg>
                        {dict.nav.emergency}
                    </span>

                    <span class="font-fredoka text-xs font-bold">
                        +52 322 384 6328
                    </span>

                </a>

                <a href={p('/contact-us')}
                    class="flex items-center justify-center gap-2.5 rounded-full bg-[#007b8a] py-4 text-center font-readex text-xs font-bold uppercase tracking-wider text-white shadow-sm transition-all hover:bg-[#006b78]">

                    <img src="/huella.svg" alt="" class="h-4 w-4" style="filter: brightness(0) invert(1);" />

                    <span>{dict.nav.bookAppointment}</span>

                </a>

            </div>

        </div>

    </div>

</header>

<style>
    .active-bubble {
        background-color: #0091a1 !important;
        color: #ffffff !important;
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(0, 145, 161, 0.25);
    }
    .active-bubble .nav-number {
        color: #ffffff !important;
    }
    .mobile-nav-link .nav-number {
        transition: color 0.2s;
    }
</style>

<script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    const header = document.getElementById('main-header');
    const navContainer = document.getElementById('nav-container');

    const navLinks = document.querySelectorAll('.nav-link');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    // Mobile Menu
    btn?.addEventListener('click', (e) => {

        e.stopPropagation();

        if (menu && menuIcon) {

            const isOpen = !menu.classList.contains('opacity-0');

            if (isOpen) {

                menu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
                menu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');

                menuIcon.innerHTML =
                    `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3.75 9h16.5m-16.5 6h16.5" />`;

            } else {

                menu.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
                menu.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');

                menuIcon.innerHTML =
                    `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18 18 6M6 6l12 12" />`;

            }

        }

    });

    // Click Outside
    document.addEventListener('click', (event) => {

        const target = event.target;

        if (menu && !menu.classList.contains('opacity-0')) {

            if (!menu.contains(target) && !btn?.contains(target)) {

                menu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
                menu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');

                if (menuIcon) {

                    menuIcon.innerHTML =
                        `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3.75 9h16.5m-16.5 6h16.5" />`;

                }

            }

        }

    });

    // Scroll Effect
    window.addEventListener('scroll', () => {

        if (window.scrollY > 30) {

            header?.classList.remove('top-5', 'w-[95%]', 'max-w-7xl');
            header?.classList.add('top-2.5', 'w-[90%]', 'max-w-5xl');

            navContainer?.classList.remove('py-2.5', 'bg-white/75');

            navContainer?.classList.add(
                'py-1.5',
                'bg-white/85',
                'shadow-[0_12px_40px_-10px_rgba(0,145,161,0.22)]',
                'border-white/40'
            );

        } else {

            header?.classList.remove('top-2.5', 'w-[90%]', 'max-w-5xl');
            header?.classList.add('top-5', 'w-[95%]', 'max-w-7xl');

            navContainer?.classList.remove(
                'py-1.5',
                'bg-white/85',
                'shadow-[0_12px_40px_-10px_rgba(0,145,161,0.22)]',
                'border-white/40'
            );

            navContainer?.classList.add('py-2.5', 'bg-white/75');

        }

    });

    // Active Link (handles /es/ prefix for Spanish)
    const currentPath = window.location.pathname.replace(/^\/es/, "") || "/";

    function highlightCurrentPage() {

        const cleanedPath = currentPath.replace(/\/$/, "");

        navLinks.forEach(link => {

            const linkPath = link.getAttribute('data-path');

            if (linkPath === '/' && (cleanedPath === '' || cleanedPath === '/')) {

                link.classList.add('active-bubble');

            } else if (linkPath && linkPath !== '/' && cleanedPath.startsWith(linkPath)) {

                link.classList.add('active-bubble');

            } else {

                link.classList.remove('active-bubble');

            }

        });

        mobileLinks.forEach(link => {

            const linkPath = link.getAttribute('data-path');

            if (linkPath === '/' && (cleanedPath === '' || cleanedPath === '/')) {

                link.classList.add('active-bubble');

            } else if (linkPath && linkPath !== '/' && cleanedPath.startsWith(linkPath)) {

                link.classList.add('active-bubble');

            } else {

                link.classList.remove('active-bubble');

            }

        });

    }

    highlightCurrentPage();
</script>