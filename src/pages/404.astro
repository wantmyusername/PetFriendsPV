---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { t } from "../i18n/translations";

const lang = Astro.url.pathname.startsWith("/es") ? "es" : "en";
const dict = t[lang];

const title = lang === "en"
    ? "Page Not Found | Pet Friends Puerto Vallarta"
    : "Página No Encontrada | Pet Friends Puerto Vallarta";
const description = lang === "en"
    ? "The page you are looking for could not be found."
    : "La página que buscas no se pudo encontrar.";

const homeHref = lang === "en" ? "/" : "/es/";
const contactHref = lang === "en" ? "/contact-us/" : "/es/contact-us/";
const tealMask = "filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(635%) hue-rotate(148deg);";
---

<html lang={lang}>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5KFJE3PF8W"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-5KFJE3PF8W');
    </script>
</head>

<body class="font-readex bg-white text-zinc-800 antialiased overflow-x-hidden">

    <Navbar lang={lang} currentPath={Astro.url.pathname} />

    <main class="relative flex min-h-screen items-center justify-center overflow-hidden px-6 pt-32 pb-24 lg:px-8">

        <div class="pointer-events-none absolute -top-20 left-1/2 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-[#0091a1]/10 blur-[120px]"></div>

        <div class="relative z-10 mx-auto grid w-full max-w-5xl items-center gap-12 lg:grid-cols-2 lg:gap-16">

            <!-- Left: message -->
            <div class="text-center lg:text-left">

                <span class="inline-flex max-w-full flex-wrap items-center justify-center gap-x-2 gap-y-1 rounded-full border border-[#0091a1]/20 bg-[#0091a1]/5 px-4 py-1.5 text-center text-[9px] font-bold uppercase tracking-[0.12em] text-[#0091a1] sm:text-[10px] sm:tracking-[0.2em]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3v18M3 12h18" />
                    </svg>
                    {dict.notFound.badge}
                </span>

                <h1 class="mt-6 font-fredoka text-4xl font-bold tracking-tight text-[#0e144a] break-words sm:text-5xl">
                    {dict.notFound.title}
                </h1>

                <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-zinc-500 font-light lg:mx-0">
                    {dict.notFound.subtitle}
                </p>

                <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:flex-wrap lg:justify-start">
                    <a href={homeHref}
                        class="group inline-flex w-full items-center justify-center gap-2.5 whitespace-nowrap rounded-full bg-[#0091a1] px-6 py-4 text-xs font-bold uppercase tracking-wider text-white shadow-sm transition-all duration-300 hover:bg-[#007b8a] hover:shadow-md active:scale-95 sm:w-auto">
                        <img src="/huella.svg" alt="" class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:rotate-12"
                            style="filter: brightness(0) invert(1);" />
                        {dict.notFound.home}
                    </a>

                    <a href={contactHref}
                        class="group inline-flex w-full items-center justify-center gap-2.5 whitespace-nowrap rounded-full border border-[#0091a1]/25 bg-[#0091a1]/5 px-6 py-4 text-xs font-bold uppercase tracking-wider text-[#0091a1] shadow-sm transition-all duration-300 hover:bg-[#0091a1] hover:text-white hover:shadow-md active:scale-95 sm:w-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
                        </svg>
                        {dict.notFound.contact}
                    </a>
                </div>

            </div>

            <!-- Right: clinical monitor -->
            <div class="relative mx-auto w-full max-w-md">

                <!-- Prominent 404 -->
                <div class="mb-5 flex items-center justify-center gap-4 sm:mb-6">
                    <span class="h-px w-10 bg-gradient-to-r from-transparent to-[#0091a1]/40 sm:w-14"></span>
                    <span class="font-fredoka text-7xl font-bold leading-none tracking-tight text-[#0091a1] drop-shadow-[0_10px_30px_rgba(0,145,161,0.25)] sm:text-8xl">
                        {dict.notFound.code}
                    </span>
                    <span class="h-px w-10 bg-gradient-to-l from-transparent to-[#0091a1]/40 sm:w-14"></span>
                </div>

                <div class="relative overflow-hidden rounded-[2rem] border border-zinc-200/80 bg-white p-6 shadow-[0_30px_70px_-25px_rgba(0,145,161,0.35)] sm:p-8">

                    <!-- Header of chart -->
                    <div class="flex items-center justify-between border-b border-zinc-100 pb-5">
                        <div class="flex items-center gap-3">
                            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#0091a1]/10">
                                <img src="/veterinary-care.svg" alt="" class="h-6 w-6" style={tealMask} />
                            </span>
                            <div>
                                <p class="font-fredoka text-sm font-bold text-[#0e144a]">{dict.notFound.statusLabel}</p>
                                <p class="text-[11px] text-zinc-400">{dict.notFound.code} &mdash; Pet Friends PV</p>
                            </div>
                        </div>
                        <span class="flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-amber-600">
                            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-500"></span>
                            {dict.notFound.statusValue}
                        </span>
                    </div>

                    <!-- Pet locator radar -->
                    <div class="mt-6 rounded-2xl bg-[#0e144a] p-5">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/50">
                                {dict.notFound.locatorLabel}
                            </span>
                            <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-emerald-400">
                                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400"></span>
                                {dict.notFound.locatorValue}
                            </span>
                        </div>

                        <div class="relative mx-auto mt-5 flex h-40 w-40 items-center justify-center">
                            <span class="absolute inset-0 rounded-full border border-white/10"></span>
                            <span class="absolute inset-6 rounded-full border border-white/10"></span>
                            <span class="absolute inset-12 rounded-full border border-white/10"></span>
                            <span class="radar-sweep absolute inset-0 rounded-full"></span>
                            <span class="absolute left-1/2 top-1/2 h-px w-1/2 origin-left -translate-y-1/2 bg-gradient-to-r from-transparent to-emerald-400/40"></span>
                            <img src="/huella.svg" alt="" class="relative h-8 w-8"
                                style="filter: brightness(0) invert(1);" />
                            <span class="radar-ping absolute left-[68%] top-[30%] h-2 w-2 rounded-full bg-emerald-400"></span>
                        </div>

                        <div class="mt-4 flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-white/40">
                            <span>GPS &#10003;</span>
                            <span>CHIP &#10003;</span>
                            <span>LOC 8 m</span>
                        </div>
                    </div>

                    <!-- Paw trail -->
                    <div class="mt-6 flex items-center justify-center gap-3">
                        <img src="/huella.svg" alt="" class="h-5 w-5 opacity-30" style={tealMask} />
                        <img src="/huella.svg" alt="" class="h-4 w-4 -translate-y-1 opacity-50" style={tealMask} />
                        <img src="/huella.svg" alt="" class="h-3.5 w-3.5 opacity-70" style={tealMask} />
                        <img src="/huesito.svg" alt="" class="h-6 w-6" style={tealMask} />
                    </div>

                </div>

                <!-- Floating bone decoration -->
                <img src="/huesito.svg" alt=""
                    class="pointer-events-none absolute -right-4 -top-6 hidden h-12 w-12 rotate-12 opacity-20 sm:block"
                    style={tealMask} />

            </div>

        </div>

    </main>

    <Footer lang={lang} />

</body>

</html>

<style>
    .radar-sweep {
        background: conic-gradient(from 0deg, rgba(52, 211, 153, 0.35), transparent 55%);
        -webkit-mask: radial-gradient(circle, #000 0%, #000 70%, transparent 71%);
        mask: radial-gradient(circle, #000 0%, #000 70%, transparent 71%);
        animation: radar-spin 2.6s linear infinite;
    }

    @keyframes radar-spin {
        to { transform: rotate(360deg); }
    }

    .radar-ping {
        animation: radar-ping 2.6s ease-out infinite;
    }

    @keyframes radar-ping {
        0% { transform: scale(0.6); opacity: 0.9; }
        70% { transform: scale(2.4); opacity: 0; }
        100% { transform: scale(2.4); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .radar-sweep, .radar-ping { animation: none; }
        .radar-ping { opacity: 0.9; }
    }
</style>
