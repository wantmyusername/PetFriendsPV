---
import "../styles/global.css";
import NotFound from "../components/NotFound.astro";

const lang = "en";
const title = "Page Not Found | Pet Friends Puerto Vallarta";
const description = "The page you are looking for could not be found.";
---

<html lang={lang}>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5KFJE3PF8W"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-5KFJE3PF8W');
    </script>
</head>

<body class="font-readex bg-white text-zinc-800 antialiased overflow-x-hidden">
    <NotFound lang="en" />
</body>

</html>
