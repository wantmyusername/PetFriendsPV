                <h2
                    class="font-fredoka text-sm sm:text-lg md:text-2xl font-bold text-white tracking-tight leading-none flex items-center gap-3">
                    {dict.services.urgency.emergency}</h2>
                <a href="tel:+523222232760"
                    class="font-fredoka text-lg sm:text-2xl md:text-3xl lg:text-4xl font-bold text-emerald-400 hover:text-emerald-300 transition-colors mt-2 select-all leading-none inline-flex items-center gap-3">
