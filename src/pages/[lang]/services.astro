                    class="h-[100%] sm:h-[150%] w-auto object-contain drop-shadow-[0_12px_24px_rgba(0,0,0,0.3)]"
                    style="image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges;" />
            </div>
        </div>
