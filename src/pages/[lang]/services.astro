                    </div>
                </div>
                <div
                    class="faq-item border border-zinc-200/60 rounded-2xl bg-[#f4f1eb]/30 overflow-hidden transition-all duration-300">
                    <button
                        class="faq-toggle w-full flex items-center justify-between p-6 text-left cursor-pointer outline-none select-none">
                        <span class="font-readex font-bold text-[16px] text-[#0e144a]">{dict.services.faq.items[1].q}</span>
                        <span
                            class="faq-icon text-[#0e144a] font-bold text-xl transition-transform duration-300">+</span>
                    </button>
                    <div class="faq-content overflow-hidden transition-all duration-300 ease-in-out"
                        style="max-height: 0px;">
                        <p class="px-6 pb-6 text-sm sm:text-base text-zinc-500 leading-relaxed">{dict.services.faq.items[1].a}</p>
                    </div>
                </div>
                <div
                    class="faq-item border border-zinc-200/60 rounded-2xl bg-[#f4f1eb]/30 overflow-hidden transition-all duration-300">
                    <button
