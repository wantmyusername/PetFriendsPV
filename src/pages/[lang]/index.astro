    #testimonial-card.opacity-0 {
        opacity: 0;
    }

    #testimonial-card.scale-\[0\.98\] {
        transform: scale(0.98);
    }
</style>
<!-- Script de Transición y Sincronización de Puntos Nativos -->
<script define:vars={{ list: testimonials }}>
    let currentIndex = 0;

    const card = document.getElementById('testimonial-card');
    const quoteEl = document.getElementById('testimonial-quote');
    const authorEl = document.getElementById('testimonial-author');
    const roleEl = document.getElementById('testimonial-role');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const dots = document.querySelectorAll('#slider-dots button');

    function updateTestimonial(index) {
        if (!card || !quoteEl || !authorEl || !roleEl) return;

        // 1. Desvanecer la tarjeta
        card.classList.add('opacity-0', 'scale-[0.98]');

        setTimeout(() => {
            // 2. Intercambiar contenido
            quoteEl.textContent = `"${list[index].quote}"`;
            authorEl.textContent = list[index].author;
            roleEl.textContent = list[index].role;

            // 3. Sincronizar clases de los puntos de paginación (Pill active state)
            dots.forEach((dot, dIndex) => {
                if (dIndex === index) {
                    dot.classList.remove('w-2', 'bg-zinc-300');
                    dot.classList.add('w-5', 'bg-[#0091a1]');
                } else {
                    dot.classList.remove('w-5', 'bg-[#0091a1]');
                    dot.classList.add('w-2', 'bg-zinc-300');
                }
            });

            // 4. Volver a mostrar la tarjeta
            card.classList.remove('opacity-0', 'scale-[0.98]');
        }, 250);
    }

    // Eventos para botones de dirección
    prevBtn?.addEventListener('click', () => {
        currentIndex = (currentIndex === 0) ? list.length - 1 : currentIndex - 1;
        updateTestimonial(currentIndex);
    });

    nextBtn?.addEventListener('click', () => {
        currentIndex = (currentIndex === list.length - 1) ? 0 : currentIndex + 1;
        updateTestimonial(currentIndex);
    });

    // Eventos para clic directo en los puntos (dots)
    dots.forEach((dot) => {
        dot.addEventListener('click', () => {
            const index = parseInt(dot.getAttribute('data-index') || '0', 10);
            if (index !== currentIndex) {
                currentIndex = index;
                updateTestimonial(currentIndex);
            }
        });
    });
</script>

<script define:vars={{ sending: dict.contact.form.sending, success: dict.contact.form.success, errorMsg: dict.contact.form.error, errMap: { origin: dict.contact.form.errOrigin, token: dict.contact.form.errToken, fast: dict.contact.form.errToken, captcha: dict.contact.form.errCaptcha, fields: dict.contact.form.errFields, email: dict.contact.form.errEmail, limit: dict.contact.form.errLimit, mail: dict.contact.form.errMail } }}>
    const homeForm = document.getElementById('home-contact-form');

    if (homeForm) {
        const ts = homeForm.querySelector('.form-ts');
        const token = homeForm.querySelector('.form-token');
        const status = document.getElementById('home-form-status');

        const showStatus = (msg, ok) => {
            if (!status) return;
            status.textContent = msg;
            status.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-700', 'bg-rose-50', 'text-rose-700');
            status.classList.add(ok ? 'bg-emerald-50' : 'bg-rose-50');
            status.classList.add(ok ? 'text-emerald-700' : 'text-rose-700');
        };

        const loadCaptcha = () => {
            fetch('/captcha.php', { cache: 'no-store', credentials: 'same-origin' })
                .then((r) => r.json())
                .then((d) => {
                    const q = homeForm.querySelector('.captcha-q');
                    if (q) q.textContent = d.q;
                    if (ts) ts.value = d.ts;
                    if (token) token.value = d.token;
                })
                .catch(() => {});
        };

        loadCaptcha();

        homeForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            if (status) status.classList.add('hidden');

            const btn = homeForm.querySelector('button[type="submit"]');
            const original = btn ? btn.textContent : '';
            if (btn) { btn.disabled = true; btn.textContent = sending; }

            try {
                const res = await fetch('/contact.php', { method: 'POST', body: new FormData(homeForm), credentials: 'same-origin' });
                const data = await res.json();

                if (data.ok) {
                    showStatus(success, true);
                    homeForm.reset();
                    loadCaptcha();
                } else {
                    showStatus(errMap[data.error] || errorMsg, false);
                }
            } catch (err) {
                showStatus(errorMsg, false);
            } finally {
                if (btn) { btn.disabled = false; btn.textContent = original; }
            }
        });
    }
</script>