---
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { t } from "../../i18n/translations";

export async function getStaticPaths() {
  return [
    { params: { lang: "es" } },
  ];
}

const lang = Astro.params.lang || Astro.props.lang || "en";
const dict = t[lang];

const title = lang === "en"
    ? "Pet Friends Puerto Vallarta | Bilingual Veterinary Hospital & 24/7 ICU"
    : "Pet Friends Puerto Vallarta | Hospital Veterinario Bilingüe y UCI 24/7";
const description = lang === "en"
    ? "Pet Friends PV is a bilingual veterinary hospital in Puerto Vallarta's Romantic Zone. Board-certified surgeons, advanced diagnostics, 24/7 emergency care, and fear-free protocols for expats and travelers."
    : "Pet Friends PV es un hospital veterinario bilingüe en la Zona Romántica de Puerto Vallarta. Cirujanos certificados, diagnósticos avanzados, emergencias 24/7 y protocolos libres de miedo.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const medicalTeam = [
{
name: "Dr. Mohammad Soleimani",
role: "Lead Surgeon & Director",
specialty: "Veterinary Medicine & Surgery",
education: "DVM - Doctor of Veterinary Medicine",
avatar: "/clinical-director.jpg"
},
];

const testimonials = dict.home.testimonials.list;
---

<html lang={lang}>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#0091a1" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pet Friends Puerto Vallarta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://petfriendspv.com/hero-home.jpg" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_MX"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="en" href="https://petfriendspv.com/" />
    <link rel="alternate" hreflang="es" href="https://petfriendspv.com/es/" />
    <link rel="alternate" hreflang="x-default" href="https://petfriendspv.com/" />
</head>

<body class="font-readex bg-white text-zinc-800 antialiased overflow-x-hidden">

    <Navbar lang={lang} currentPath={Astro.url.pathname} />

    <!-- 1. HERO SECTION (Luminous Editorial Split Layout con fachada visible) -->
    <section class="relative min-h-[78vh] lg:min-h-[88vh] flex items-center overflow-hidden bg-[#fdfdfd]"
        aria-label="Welcome and Introduction">

        <!-- Capas de fondo optimizadas para mostrar la clínica veterinaria exterior con claridad -->
        <div class="absolute inset-0 z-0">
            <!-- Imagen de la veterinaria con alta opacidad y color natural -->
            <img src="/hero-home.jpg?ver=1" alt="Pet Friends Puerto Vallarta Exterior Facade"
                class="w-full h-full object-cover opacity-85 max-md:object-[50%_30%]" fetchpriority="high"
                loading="eager" />

            <!-- Transición de neblina blanca: Excelente legibilidad a la izquierda, total transparencia a la derecha -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#fdfdfd] from-50% to-transparent">
            </div>
            <!-- Suavizado inferior sutil -->
            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#fdfdfd]/10"></div>



            <!-- Destellos de luz natural turquesa para aportar vitalidad y frescura costera -->
            <div
                class="absolute top-1/3 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] rounded-full bg-[#0091a1]/5 blur-[90px] pointer-events-none mix-blend-multiply">
            </div>
        </div>

        <!-- Contenedor Principal (Optimizado para evitar colisiones con el Navbar) -->
        <div class="container mx-auto max-w-7xl px-6 relative z-10 pt-32 sm:pt-40 lg:pt-24 pb-16 lg:pb-0">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center w-full">

                <!-- Columna Izquierda: Mensajes, Badge, Botones y Prueba Social (Tipografía Oscura de Lujo) -->
                <div class="lg:col-span-7 space-y-8 text-center lg:text-left">

                    <!-- Badge de Cristal Esmerilado Claro Premium -->
                    <div
                        class="inline-flex items-center gap-3 py-1.5 px-4 rounded-full bg-white/75 backdrop-blur-md border border-zinc-200/80 text-[#0a0e35] text-[10px] sm:text-xs font-semibold uppercase tracking-[0.18em] shadow-sm font-readex">
                        <span class="flex h-2 w-2 relative">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#0091a1] opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#0091a1]"></span>
                        </span>
                        {dict.home.hero.badge}
                    </div>

                    <!-- Jerarquía de Encabezados Refinada (Contraste Luminous) -->
                    <div class="space-y-5">
                        <h1
                            class="font-fredoka text-4xl sm:text-6xl lg:text-[56px] text-[#0a0e35] font-extrabold leading-[1.08] tracking-tight">
                            {dict.home.hero.title} <br class="hidden md:inline" />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0091a1] to-[#0a0e35]">
                                {dict.home.hero.titleHighlight}
                            </span>
                        </h1>
                        <p
                            class="font-readex text-base sm:text-lg text-slate-600/95 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
                            {dict.home.hero.subtitle}
                        </p>
                    </div>

                    <!-- Botones de Acción Estilo App de Lujo (Ajustados a paleta clara) -->
                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start font-readex">
                        <!-- Botón WhatsApp: Vestido con el color de marca #0091a1 -->
                        <a class="relative group inline-flex justify-center items-center gap-3 px-8 py-4 rounded-full bg-[#0091a1] text-white font-bold text-xs uppercase tracking-wider hover:bg-[#007b8a] active:scale-98 transition-all duration-300 shadow-[0_10px_30px_-5px_rgba(0,145,161,0.25)] overflow-hidden"
                            href={`https://wa.me/523223846328?text=${encodeURIComponent(dict.whatsapp.general)}`} target="_blank" rel="noopener noreferrer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 relative" fill="currentColor"
                                viewBox="0 0 448 512">
                                <path
                                    d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
                            </svg>
                            <span class="relative">{dict.home.hero.bookViaWhatsApp}</span>
                        </a>

                        <!-- Botón Emergencias: Fondo suave para evitar sobrecargar -->
                        <a class="relative group inline-flex justify-center items-center gap-3 px-8 py-4 rounded-full bg-rose-50/80 border border-rose-200 text-rose-700 font-bold text-xs uppercase tracking-wider hover:bg-rose-100 hover:text-rose-800 active:scale-98 transition-all duration-300"
                            href="tel:+523222232760">
                            <span class="absolute -top-1 -left-1 w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                                stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.634-5.165-3.974-6.799-6.8l1.293-.97a1.125 1.125 0 0 0 .417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                            </svg>
                            <span>{dict.home.hero.emergencyCall}</span>
                        </a>
                    </div>

                    <!-- Prueba Social / Indicadores de Confianza Micro-detallados -->
                    <div
                        class="pt-6 border-t border-zinc-200/60 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-left">
                        <div class="flex -space-x-3">
                            <div
                                class="w-9 h-9 rounded-full border-2 border-white bg-slate-200 flex items-center justify-center text-[10px] font-bold text-white overflow-hidden shadow-sm">
                                <img src="/avatar-pet-1.jpg"
                                    alt="Client's Pet" class="w-full h-full object-cover">
                            </div>
                            <div
                                class="w-9 h-9 rounded-full border-2 border-white bg-slate-200 flex items-center justify-center text-[10px] font-bold text-white overflow-hidden shadow-sm">
                                <img src="/avatar-pet-2.jpg"
                                    alt="Client's Pet" class="w-full h-full object-cover">
                            </div>
                            <div
                                class="w-9 h-9 rounded-full border-2 border-white bg-slate-200 flex items-center justify-center text-[10px] font-bold text-white overflow-hidden shadow-sm">
                                <img src="/avatar-pet-3.jpg"
                                    alt="Client's Pet" class="w-full h-full object-cover">
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center gap-1">
                                <span class="text-amber-500 text-sm">★★★★★</span>
                                <span class="text-[#0a0e35] text-xs font-bold font-readex ml-1">{dict.home.hero.rating}</span>
                            </div>
                            <p
                                class="text-[11px] text-zinc-500 uppercase tracking-widest font-medium font-readex mt-0.5">
                                {dict.home.hero.trusted}</p>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Imagen Principal con Enmarcado Escultórico -->
                <div class="lg:col-span-5 relative flex justify-center">

                    <!-- Resplandor decorativo interno exclusivo de la imagen -->
                    <div
                        class="absolute inset-0 bg-gradient-to-tr from-[#0091a1]/15 to-transparent blur-3xl rounded-full scale-95 pointer-events-none">
                    </div>

                    <!-- Contenedor Principal de la Imagen (Silueta sofisticada con doble borde claro) -->
                    <div
                        class="relative w-[320px] h-[450px] sm:w-[400px] sm:h-[480px] rounded-[60px_160px_60px_160px] overflow-hidden bg-white/40 p-1.5 backdrop-blur-sm border border-zinc-200/80 shadow-[0_20px_40px_rgba(0,0,0,0.08)] z-10 transition-transform duration-500 hover:scale-[1.01]">
                        <!-- Contenedor interno para recortar la imagen de forma limpia -->
                        <div class="w-full h-full rounded-[54px_154px_54px_154px] overflow-hidden relative">
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0e35]/10 to-transparent z-10"></div>
                            <img src="/veterinario-principal.jpg?ver=1" alt="Experienced Veterinarian"
                                class="w-full h-full object-cover scale-102 hover:scale-105 transition-transform duration-700 ease-out"
                                loading="lazy" />
                        </div>
                    </div>

                    <!-- ADDON 1: Sello Circular Rotado Elegante (Fondo turquesa de marca #0091a1) -->
                    <div
                        class="absolute -top-5 -right-2 sm:-right-4 bg-[#0091a1] border-2 border-white rounded-full w-28 h-28 flex flex-col items-center justify-center shadow-xl transform rotate-6 hover:rotate-0 transition-transform duration-500 z-30 select-none">
                        <!-- Anillo de puntos decorativos internos -->
                        <div
                            class="absolute inset-1 border border-dashed border-white/20 rounded-full pointer-events-none">
                        </div>

                        <span class="text-[7px] font-bold tracking-[0.22em] text-white/90 uppercase leading-none">{dict.home.hero.boardCertified}</span>
                        <span class="font-fredoka text-[22px] font-black text-white my-1 leading-none">{dict.home.hero.dvm}</span>
                        <span
                            class="text-[7px] font-bold tracking-[0.18em] text-teal-100 uppercase font-readex leading-none">{dict.home.hero.veterinarian}</span>
                    </div>

                    <!-- ADDON 2: Tarjeta Credencial Minimalista de Alta Fidelidad (Fondo blanco cristalizado) -->
                    <div
                        class="absolute bottom-6 -left-6 bg-white/95 backdrop-blur-xl px-5 py-4 rounded-2xl shadow-[0_15px_30px_rgba(0,0,0,0.06)] border border-zinc-200/80 flex items-center gap-4 z-30 select-none font-readex max-w-[220px]">
                        <div
                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#0091a1]/10 text-[#0091a1] border border-[#0091a1]/20">
                            <!-- Icono Clínico Avanzado -->
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                            </svg>
                        </div>
                        <div>
                            <h5 class="text-[9px] font-bold text-[#0a0e35] uppercase tracking-wider leading-none">
                                {dict.home.hero.clinicalQuality}</h5>
                            <p class="font-fredoka text-xs font-bold text-[#0091a1] mt-1">{dict.home.hero.expatChoice}</p>
                            <div class="mt-1.5 flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#0091a1] inline-block"></span>
                                <span class="text-[8px] text-zinc-500 font-medium">{dict.home.hero.verified}</span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </section>

    <!-- 2. EDITORIAL INTRO SECTION (Seamless Light-Mist Transition) -->
    <section
        class="bg-gradient-to-b from-[#fdfdfd] to-[#f0f7f8] pb-24 px-6 lg:px-8 relative z-10 border-b border-zinc-100/80"
        aria-label="Our Philosophy">
        <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

                <!-- Columna Izquierda: Introducción e Impacto (5/12 width) -->
                <div class="lg:col-span-5 space-y-5">
                    <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#0091a1] block">
                        {dict.home.intro.welcome}
                    </span>
                    <h2
                        class="font-fredoka text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#0a0e35] leading-[1.15] tracking-tight">
                        {dict.home.intro.title} <br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0091a1] to-[#0a0e35]">
                            {dict.home.intro.titleHighlight}
                        </span>
                    </h2>
                    <!-- Línea decorativa minimalista de marca -->
                    <div class="w-16 h-0.5 bg-[#0091a1] mt-6"></div>
                </div>

                <!-- Columna Derecha: Narrativa Editorial & Propuestas de Valor (7/12 width) -->
                <div class="lg:col-span-7 space-y-8 font-readex">
                    <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-light font-readex">
                        {dict.home.intro.desc}
                    </p>

                    <!-- Cita Destacada con Borde Fino Turquesa -->
                    <div class="border-l-2 border-[#0091a1] pl-6 py-1">
                        <p class="text-sm sm:text-base font-semibold text-[#0a0e35] italic leading-relaxed">
                            {dict.home.intro.quote}
                        </p>
                    </div>

                    <!-- Tarjetas de Valor Estilo Cristal Flotante (Ligeras y sofisticadas) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-6 border-t border-zinc-200/50">
                        <div
                            class="p-5 rounded-2xl bg-white/75 backdrop-blur-sm border border-white shadow-[0_8px_30px_rgba(0,0,0,0.02)] space-y-1.5">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-[#0091a1]">{dict.home.intro.accredited.title}
                            </h4>
                            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
                                {dict.home.intro.accredited.desc}
                            </p>
                        </div>
                        <div
                            class="p-5 rounded-2xl bg-white/75 backdrop-blur-sm border border-white shadow-[0_8px_30px_rgba(0,0,0,0.02)] space-y-1.5">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-[#0091a1]">{dict.home.intro.bilingual.title}
                            </h4>
                            <p class="text-[11px] text-zinc-500 font-light leading-relaxed">
                                {dict.home.intro.bilingual.desc}
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 2.5 CINEMATIC EDGE-TO-EDGE PANORAMA GALLERY (Contrast Separator) -->
    <section class="w-full overflow-hidden bg-[#f0f7f8] pb-20 relative z-10" aria-label="Clinical Facilities Gallery">
        <div class="w-full">

            <!-- Retícula de 4 columnas con separaciones finas estilo galería de arte -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-1.5 lg:gap-2">

                <!-- Gallery Image 1 -->
                <div class="overflow-hidden h-[200px] sm:h-[300px] lg:h-[380px]">
                    <img src="/gallery-home-1.jpg" alt="" loading="lazy" class="w-full h-full object-cover" />
                </div>

                <!-- Gallery Image 2 -->
                <div class="overflow-hidden h-[200px] sm:h-[300px] lg:h-[380px]">
                    <img src="/gallery-home-2.jpg" alt="" loading="lazy" class="w-full h-full object-cover" />
                </div>

                <!-- Gallery Image 3 -->
                <div class="overflow-hidden h-[200px] sm:h-[300px] lg:h-[380px]">
                    <img src="/gallery-home-3.jpg" alt="" loading="lazy" class="w-full h-full object-cover" />
                </div>

                <!-- Gallery Image 4 -->
                <div class="overflow-hidden h-[200px] sm:h-[300px] lg:h-[380px]">
                    <img src="/gallery-home-4.jpg" alt="" loading="lazy" class="w-full h-full object-cover" />
                </div>

            </div>

        </div>

        <!-- Fade suave al blanco para evitar corte abrupto -->
        <div
            class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-[#fdfdfd] to-transparent pointer-events-none">
        </div>
    </section>

    <!-- 3. BENTO GRID OF CLINICAL SERVICES -->
    <section class="bg-[#fdfdfd] py-24 px-6 lg:px-8 relative z-10" id="specialties">
        <div class="max-w-7xl mx-auto">

            <!-- Encabezado de la Sección -->
            <div class="text-center mb-20 space-y-3">
                <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#0091a1] block">
                    {dict.home.specialties.eyebrow}
                </span>
                <h2 class="font-fredoka text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#0a0e35] tracking-tight">
                    {dict.home.specialties.title}
                </h2>
                <p class="text-sm sm:text-base text-zinc-500 max-w-xl mx-auto font-readex font-light leading-relaxed">
                    {dict.home.specialties.subtitle}
                </p>
            </div>

            <!-- Grid de 3 columnas geométricas impecables -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                <!-- Tarjeta Bento 1: Diagnostics (Gradiente Brisa Turquesa + Líneas Topográficas) -->
                <div
                    class="md:col-span-2 bg-gradient-to-br from-[#e6f4f6] to-[#f4fafb] rounded-[2.5rem] p-8 md:p-11 border border-[#0091a1]/10 flex flex-col justify-between relative overflow-hidden group hover:shadow-[0_25px_50px_rgba(0,145,161,0.08)] hover:-translate-y-1.5 transition-all duration-500 ease-out">

                    <!-- SVG de Fondo: Curvas Orgánicas de Nivel (Topografía/Ondas de Agua) -->
                    <svg class="absolute inset-0 w-full h-full opacity-[0.06] text-[#0091a1] pointer-events-none"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 800 400">
                        <path
                            d="M-100 150 C 200 300, 400 50, 900 200 M-100 180 C 200 330, 400 80, 900 230 M-100 210 C 200 360, 400 110, 900 260 M-100 120 C 200 270, 400 20, 900 170"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>

                    <div class="relative z-10 space-y-8">
                        <div class="flex-shrink-0 w-28 h-28 bg-[#f4e9d7] flex items-center justify-center transition-colors duration-300"
                            style="clip-path:path('M 50 8 C 72 2 93 18 95 45 C 97 72 82 93 55 96 C 28 99 5 85 3 58 C 1 31 28 14 50 8 Z')">
                            <img src="/veterinary-care.svg" alt="" class="w-12 h-12" />
                        </div>

                        <div class="space-y-3">
                            <h3 class="font-fredoka text-2xl sm:text-3xl font-bold text-[#0a0e35]">{dict.home.specialties.diagnostics.title}</h3>
                            <p class="text-sm text-slate-600 leading-relaxed max-w-lg font-readex font-light">
                                {dict.home.specialties.diagnostics.desc}
                            </p>
                        </div>

                        <div class="flex flex-wrap gap-2 pt-1">
                            <span
